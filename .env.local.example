# Local Supabase. `npm run db:start` prints both values on first run.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# When you link a hosted project, swap these for the values under
# Project Settings → API.
#
# The service role key is never needed by this app and must never appear
# in a NEXT_PUBLIC_ variable — anything with that prefix is compiled into
# the browser bundle. Server-only secrets go in unprefixed variables and
# are read exclusively from Server Components, Server Actions or Route
# Handlers.
