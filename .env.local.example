# Clerk. Both values are on the API Keys page of the Toplance
# application in the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk sends people who need to sign in.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Postgres. `npm run db:up` starts it on this port; staging and
# production get their own value from Coolify.
DATABASE_URL=postgres://toplance:toplance@127.0.0.1:54329/toplance

# Document storage, S3-compatible. `npm run db:up` starts MinIO with the
# credentials below for local work. Staging and production use Cloudflare
# R2:
#
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=toplance-documents
#
# `auto` is not a placeholder — R2 has a single region and rejects an AWS
# region name.
#
# The key pair comes from an R2 API token scoped to that one bucket.
# Scope it tightly: `removeDocument` and the replace path in
# `uploadDocument` both call DeleteObject, so this credential can destroy
# passport scans. It must not reach the backup bucket, or a leak takes
# the originals and the copies together.
#
# Server-only secrets go in unprefixed variables and are read only from
# Server Components, Server Actions or Route Handlers. Anything with a
# NEXT_PUBLIC_ prefix is compiled into the browser bundle.
S3_ENDPOINT=http://127.0.0.1:54330
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY_ID=toplance
S3_SECRET_ACCESS_KEY=toplance123
