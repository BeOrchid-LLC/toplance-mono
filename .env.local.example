# Clerk. Both values are on the API Keys page of the Toplance
# application in the Clerk dashboard — its *development* instance, which
# is for local work only. Staging and production each have their own
# application and their own key pair; see "Clerk, one instance per
# environment" in the README before deploying one.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk sends people who need to sign in.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Postgres. `npm run db:up` starts it on this port; staging and
# production get their own value from Coolify.
DATABASE_URL=postgres://toplance:toplance@127.0.0.1:54329/toplance

# Document storage, S3-compatible. `npm run db:up` starts MinIO with the
# credentials below for local work. Staging and production use Cloudflare
# R2:
#
#   S3_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=toplance-documents-staging   # toplance-documents in production
#
# `auto` is not a placeholder — R2 has a single region and rejects an AWS
# region name.
#
# The `.eu.` in the endpoint is not optional. The buckets are created in
# R2's EU jurisdiction, so passport scans are guaranteed to stay in the
# EU — and a jurisdictional bucket is only reachable through its own
# endpoint. The plain `<account-id>.r2.cloudflarestorage.com` form that
# the dashboard shows first answers a jurisdictional bucket with
# NoSuchBucket, which reads exactly like a bucket that was never created.
# Take the endpoint from the "European Union (EU)" tab, not "Default".
#
# Jurisdiction is fixed when the bucket is created and cannot be changed
# afterwards.
#
# The key pair comes from an R2 API token scoped to that one bucket.
# Scope it tightly: `removeDocument` and the replace path in
# `uploadDocument` both call DeleteObject, so this credential can destroy
# passport scans. It must not reach the backup bucket, or a leak takes
# the originals and the copies together.
#
# Server-only secrets go in unprefixed variables and are read only from
# Server Components, Server Actions or Route Handlers. Anything with a
# NEXT_PUBLIC_ prefix is compiled into the browser bundle.
S3_ENDPOINT=http://127.0.0.1:54330
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY_ID=toplance
S3_SECRET_ACCESS_KEY=toplance123

# Outbound email, via Resend's plain HTTP API — see @/lib/notifications/email.
# Left unset locally: `sendEmail` logs and skips instead of sending, which is
# fine for `npm run dev` and for tests.
RESEND_API_KEY=
EMAIL_FROM=Toplance <notifications@example.com>

# Absolute base URL used to build the links inside notification emails.
# Defaults to http://localhost:3000 when unset — only staging and
# production need to set this.
APP_URL=

# OpenAI. The one switch every AI feature degrades on — see
# @/lib/ai/models. Left unset, the intake agent runs its scripted
# question list and no other AI feature offers itself, which is a
# complete product: intake still finishes and the checklist is still
# built from corridor data. Set it and the same screen becomes a
# conversation the model drives.
OPENAI_API_KEY=

# The bearer secret `src/app/api/cron/companion/route.ts` checks before
# sending the weekly post-arrival digest. That route has no Clerk
# session to guard it — it is called by a scheduler, not a browser — so
# this is the only thing standing between the URL and anyone who finds
# it. Left unset, the route refuses every request with a 503 rather than
# running unguarded. Generate a long random value for staging and
# production and give the same value to whatever calls this URL on a
# timer (a Vercel Cron entry, or an external scheduler doing a plain
# `curl -H "Authorization: Bearer $CRON_SECRET" .../api/cron/companion`).
CRON_SECRET=

# Travel Buddy — read twice from one response. It grounds the Phase 5
# arrival plan with destination facts (currency, capital, timezone,
# dialling code), and it is the only API provider behind the curated
# corridors table: it fills allowed stay, passport validity, embassy and
# eVisa links on a rule set curated leaves blank. It returns no document
# list, so it can never lead a rule set — a corridor the table does not
# hold stays unserved. Unset, the provider is inert: itineraries are
# still generated and requirements still render, both without those
# sourced figures.
# Key from RapidAPI: https://rapidapi.com/TravelBuddyAI/api/visa-requirement
TRAVEL_BUDDY_API_KEY=

# VisaList, via RapidAPI: https://rapidapi.com/hakr/api/visa-list
# Entry rules (visa category, allowed stay, eVisa links) for every
# destination a passport can reach. NOT document checklists — it sells
# none, which is why the provider is a contributor and never leads.
# One call per passport, cached a week; the Basic tier meters one an hour.
# Left empty on purpose, like every other secret here: a placeholder is
# truthy, so `cp .env.local.example .env.local` would send the first call
# down the live path with a garbage key, latch `keyRejected` on the 401,
# and report a configured key to /api/cron/visa-warm — instead of serving
# the recorded sample below.
VISALIST_API_KEY=

# Serve the recorded sample in `src/lib/visa/visalist.sample.ts` instead
# of calling the vendor. Six destinations for a Nigerian passport,
# captured 2026-09-02 from a real call. For local work without a key, or
# without spending quota. Inert in a production build whatever it says.
VISALIST_RECORDED=1

# Open Exchange Rates: https://openexchangerates.org — a paid plan, per
# the 01/09 review's answer on where rates should come from.
#
# One call a day fills `fx_rates` for every currency at once (see
# /api/cron/fx-rates), and each conversion a traveller sees is a cross of
# two cached rows — so the plan's request budget is the number of days in
# the month, not the number of page views.
#
# Empty here for the same reason as every other secret: without it the
# refresh reports "no key set" and fees are shown in the mission's own
# currency alone, which is exactly how the product behaved before the
# conversion existed.
OPEN_EXCHANGE_RATES_APP_ID=
