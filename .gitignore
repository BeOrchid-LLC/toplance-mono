pnpm-debug.log*
lerna-debug.log*

# ---------- deployment tooling ----------
.vercel/

# ---------- supabase ----------
# supabase/.gitignore covers these too; repeated here so the root file
# tells the whole story on its own.
supabase/.temp/
supabase/.branches/

